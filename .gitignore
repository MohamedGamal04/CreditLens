# Data & model artifacts (never commit the multi-GB Kaggle data or trained models)
data/raw/*
data/processed/*
models/*
!**/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Notebook scratch outputs
notebooks/*-scratch.ipynb

# Secrets
.kaggle/
*.env

# OS / IDE / local tooling
.DS_Store
Thumbs.db
.vscode/
.claude/

# Generated profiling/EDA reports
reports/

# Local design docs / plans (superpowers specs + plans)
docs/

# Design bundle internals we don't need to track (keep CreditLens.html + src)
frontend/.thumbnail

# Sample batch CSV (real-data-derived; regenerate via scripts/make_sample_batch.py)
frontend/sample_applications.csv

# CatBoost training artifacts
catboost_info/
**/catboost_info/

# MLflow tracking (training runs inside backend/)
mlruns/
**/mlruns/
mlartifacts/
**/mlartifacts/
# Local mlflow UI / experiment outputs
.vexp/
mlflow.db
**/mlflow.db
